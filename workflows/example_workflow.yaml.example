id: markdown-to-plot.example_workflow
name: Markdown to Plot Example Workflow
version: "1.0.0"
description: Example agent-owned workflow for Markdown to Plot. Rename this file to .yaml to publish it.
inputs:
  required:
    - input_data
  optional: []
execution:
  mode: sequential
  max_concurrency: 1
  on_error: fail_fast
steps:
  - id: run_primary_skill
    skill_id: markdown_to_plot_analysis
    is_final: true
    params:
      input_data:
        from: input.input_data
outputs:
  final:
    from: step.run_primary_skill.result
metadata:
  requires_approval: false
  estimated_duration_seconds: 30
  owner: markdown-to-plot
ui:
  category: Markdown to Plot
  display_name: Markdown to Plot Example Workflow
  summary: Example workflow that invokes the primary Markdown to Plot skill.
